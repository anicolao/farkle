    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.1.0",
    "@types/bun": "1.3.10",
    "@types/three": "0.185.4",
    "firebase-tools": "15.25.0",
    "svelte-check": "4.7.2",
    "typescript": "5.9.3",
