{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "allowJs": true, "checkJs": false, "isolatedModules": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "types": ["vite/client", "bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "scripts/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
